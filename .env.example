# Create a fresh Gemini API/Auth key in Google AI Studio.
# Never commit your real key.
GEMINI_API_KEY=replace_with_new_key

# Current default chosen for a low-cost/high-volume activity generator.
# Change this environment variable later without changing your app code.
GEMINI_MODEL=gemini-2.5-flash-lite

# Secret used ONLY between your main backend and this AI microservice.
# Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=replace_with_random_internal_secret

# Comma-separated. If only your server calls this API, CORS is not important.
ALLOWED_ORIGINS=https://your-web-app.example.com
